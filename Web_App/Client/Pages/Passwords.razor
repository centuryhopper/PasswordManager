@page "/passwords"
@using static Shared.Models.ServiceResponses
@using Radzen
@using Radzen.Blazor
@attribute [Authorize]


<style>
    .passwords-grid {
        --rz-grid-cell-font-size: 1.5rem;
    }

    .passwords-grid .rz-grid-table td,
    .passwords-grid .rz-cell-data,
    .passwords-grid .rz-cell-data span,
    .passwords-grid td .rz-textbox,
    .passwords-grid td .rz-textarea {
        font-size: 1.1rem;
    }
</style>

@if (doneLoadingLst && didJsLoad)
{
    <RadzenStack Orientation="Radzen.Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" class="mb-3">
        <InputFile OnChange="OnCsvSelected" accept=".csv" />
        <RadzenButton Text="Upload CSV" Icon="upload" ButtonStyle="ButtonStyle.Secondary"
                      Disabled="@(pendingUpload.Count == 0 || uploading)" Click="SubmitCsvAsync" />
        <RadzenLink Path="templates/example.csv" Text="Download example CSV" target="_blank" />
        @if (pendingUpload.Count > 0)
        {
            <RadzenText TextStyle="TextStyle.Body2">@pendingUpload.Count row(s) ready to upload</RadzenText>
        }
    </RadzenStack>

    <RadzenDataGrid class="passwords-grid" @ref="grid" TItem="PasswordAccountDTO" Data="@Items"
                    EditMode="DataGridEditMode.Single" AllowFiltering="true" FilterMode="FilterMode.Simple"
                    FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" AllowSorting="true" AllowPaging="true" PageSize="10"
                    PagerHorizontalAlign="HorizontalAlign.Center" ShowPagingSummary="true" AllowColumnResize="true" Sort="@Reset"
                    Page="@Reset" Filter="@Reset">
        <HeaderTemplate>
            <RadzenButton Icon="add_circle" Text="Add password" ButtonStyle="ButtonStyle.Success" Click="InsertRow"
                          Disabled="@(itemsToInsert.Count > 0)" />
            <RadzenButton Icon="playlist_add" Text="Add multiple" ButtonStyle="ButtonStyle.Primary" Click="AddMultipleAsync"
                          class="rz-ms-2" />
        </HeaderTemplate>
        <Columns>
            @* Read-only columns: no EditTemplate, so they stay as text while editing *@
            @* <RadzenDataGridColumn TItem="PasswordAccountDTO" Property="@nameof(PasswordAccountDTO.Id)" Title="Id" Width="80px" />
            <RadzenDataGridColumn TItem="PasswordAccountDTO" Property="@nameof(PasswordAccountDTO.UserId)" Title="User Id" Width="100px" /> *@

            <RadzenDataGridColumn TItem="PasswordAccountDTO" Property="@nameof(PasswordAccountDTO.Title)" Title="Title">
                <EditTemplate Context="p">
                    <RadzenTextBox @bind-Value="p.Title" Name="Title" Style="width: 100%;" />
                    <RadzenRequiredValidator Component="Title" Text="Title is required" Popup="true" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PasswordAccountDTO" Property="@nameof(PasswordAccountDTO.Username)"
                                  Title="Username">
                <EditTemplate Context="p">
                    <RadzenTextBox @bind-Value="p.Username" Name="Username" Style="width: 100%;" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PasswordAccountDTO" Property="@nameof(PasswordAccountDTO.Password)"
                                  Title="Password" Filterable="false" Sortable="false">
                <Template Context="p">
                    <span>@(new string('*', Math.Min(p.Password?.Length ?? 0, 10)))</span>
                </Template>
                <EditTemplate Context="p">
                    <RadzenTextArea @bind-Value="p.Password" Name="Password" Style="width: 12rem;" Rows="2" />
                    <RadzenRequiredValidator Component="Password" Text="Password is required" Popup="true" />
                </EditTemplate>
            </RadzenDataGridColumn>

            <RadzenDataGridColumn TItem="PasswordAccountDTO" Property="@nameof(PasswordAccountDTO.CreatedAt)"
                                  Title="Created" FormatString="{0:d}" Width="170px" />
            <RadzenDataGridColumn TItem="PasswordAccountDTO" Property="@nameof(PasswordAccountDTO.LastUpdatedAt)"
                                  Title="Last Updated" FormatString="{0:d}" Width="170px" />

            <RadzenDataGridColumn TItem="PasswordAccountDTO" Context="p" Title="Actions" Width="140px" Filterable="false"
                                  Sortable="false" TextAlign="TextAlign.Right">
                @* Frozen="true" FrozenPosition="FrozenColumnPosition.Right" *@
                <Template Context="p">
                    <RadzenButton Icon="edit" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                  Size="ButtonSize.Medium" Click="@(() => EditRow(p))" @onclick:stopPropagation="true" />
                    <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Flat"
                                  Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(() => DeleteRow(p))"
                                  @onclick:stopPropagation="true" />
                </Template>
                <EditTemplate Context="p">
                    <RadzenButton Icon="check" ButtonStyle="ButtonStyle.Success" Variant="Variant.Flat"
                                  Size="ButtonSize.Medium" Click="@(() => SaveRow(p))" Disabled="@saving" />
                    <RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Flat"
                                  Size="ButtonSize.Medium" class="rz-my-1 rz-ms-1" Click="@(() => CancelEdit(p))" />
                </EditTemplate>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
else
{
    <div class="d-flex justify-content-center">
        <div id="loadingIndicator" class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}



@code {
    private bool doneLoadingLst = false;
    private bool saving = false;
    private bool uploading = false;

    private RadzenDataGrid<PasswordAccountDTO> grid = default!;
    private HandyToast handyToast = default!;
    private StackedHandyToast stackedHandyToast = default!;
    private NotificationModal notificationModal { get; set; } = default!;
    private HttpClient httpClient { get; set; } = default!;
    private int userId { get; set; }

    private List<PasswordAccountDTO> Items = new();

    // Rows currently being inserted / edited (Radzen's recommended inline-edit bookkeeping)
    private readonly List<PasswordAccountDTO> itemsToInsert = new();
    private readonly List<PasswordAccountDTO> itemsToUpdate = new();

    // Snapshot of a row before editing so Cancel (or a failed update) can revert it,
    // since the edit templates bind directly to the row object.
    private PasswordAccountDTO? editSnapshot;

    // Rows parsed from the selected CSV, waiting for "Upload CSV"
    private List<PasswordAccountDTO> pendingUpload = new();
    private bool didJsLoad = false;


    private record NewPasswordRow(string Title, string Username, string Password);

    private async Task AddMultipleAsync()
    {
        var rows = await jsRuntime.InvokeAsync<List<NewPasswordRow>?>("NOTIFY.addPasswords");
        if (rows is null || rows.Count == 0) return; // cancelled

        var now = DateTime.UtcNow;
        var nextId = Items.DefaultIfEmpty(new()).Max(x => x.Id) + 1;

        var list = rows.Select((r, i) => new PasswordAccountDTO
        {
            Id = nextId + i,
            UserId = userId,
            Title = r.Title,
            Username = r.Username,
            Password = r.Password,
            CreatedAt = now,
            LastUpdatedAt = now,
        }).ToList();

        var response = await httpClient.PostAsJsonAsync("api/PasswordManager/add-passwords", list);
        var results = (await response.Content.ReadFromJsonAsync<List<HandyGeneralResponseWithPayload>>())
                      ?? new List<HandyGeneralResponseWithPayload>();

        var errors = results.Where(r => !r.Flag).ToList();
        if (errors.Count > 0 || results.Count != list.Count)
        {
            foreach (var e in errors)
                await jsRuntime.InvokeVoidAsync("NOTIFY.toast", "error", e.Message, "Error");
            if (results.Count != list.Count && errors.Count == 0)
                await jsRuntime.InvokeVoidAsync("NOTIFY.toast", "error", "Unexpected server response.", "Error");
            return;
        }

        for (var i = 0; i < list.Count; i++)
            list[i].Id = int.Parse(results[i].Payload);

        Items.AddRange(list);
        await grid.Reload();
        await jsRuntime.InvokeVoidAsync("NOTIFY.toast", "success",
            $"Added {list.Count} password{(list.Count == 1 ? "" : "s")}", "Success");
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            didJsLoad = true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        httpClient = httpClientFactory.CreateClient(Constants.HTTP_CLIENT);

        // Resolve the user before the grid becomes interactive so new rows get the right UserId
        var authState = await ((ApiAuthenticationStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        userId = Convert.ToInt32(authState.User.Claims.First(c => c.Type == ClaimTypes.NameIdentifier).Value);

        await LoadAsync();
        doneLoadingLst = true;
    }

    private async Task LoadAsync()
    {
        var result = await httpClient.GetFromJsonAsync<IEnumerable<PasswordAccountDTO>>("api/PasswordManager/passwords");
        Items = (result ?? Enumerable.Empty<PasswordAccountDTO>()).OrderBy(p => p.Id).ToList();
    }

    // ---------- Edit-state bookkeeping ----------

    private void Reset()
    {
        itemsToInsert.Clear();
        itemsToUpdate.Clear();
    }

    private void Reset(PasswordAccountDTO item)
    {
        itemsToInsert.Remove(item);
        itemsToUpdate.Remove(item);
    }

    private async Task InsertRow()
    {
        if (!grid.IsValid) return;
        CancelOpenEdits();

        var item = new PasswordAccountDTO { Title = "", Username = "", Password = "" };
        itemsToInsert.Add(item);
        await grid.InsertRow(item);
    }

    private async Task EditRow(PasswordAccountDTO item)
    {
        if (!grid.IsValid) return;
        CancelOpenEdits();

        editSnapshot = Clone(item);
        itemsToUpdate.Add(item);
        await grid.EditRow(item);
    }

    private void CancelEdit(PasswordAccountDTO item)
    {
        if (itemsToUpdate.Contains(item) && editSnapshot is not null)
        {
            Restore(item, editSnapshot);
        }

        Reset(item);
        editSnapshot = null;
        grid.CancelEditRow(item);
    }

    // Single edit mode: close whatever row is open before opening another
    private void CancelOpenEdits()
    {
        foreach (var open in itemsToInsert.Concat(itemsToUpdate).ToList())
        {
            CancelEdit(open);
        }
    }

    // ---------- Save (create or update) ----------

    private async Task SaveRow(PasswordAccountDTO item)
    {
        if (!grid.IsValid) return;

        saving = true;
        try
        {
            var ok = itemsToInsert.Contains(item)
                ? await CreateAsync(item)
                : await UpdateAsync(item);

            if (!ok) return; // keep the row in edit mode so the user can fix it

            Reset(item);
            editSnapshot = null;
            await grid.UpdateRow(item); // closes the editor
            await grid.Reload();
        }
        finally
        {
            saving = false;
        }
    }

    private async Task<bool> CreateAsync(PasswordAccountDTO item)
    {
        item.Id = Items.DefaultIfEmpty(new()).Max(x => x.Id) + 1;
        item.UserId = userId;
        item.CreatedAt = DateTime.UtcNow;
        item.LastUpdatedAt = DateTime.UtcNow;

        // The endpoint takes a list, so send a list of one
        var response = await httpClient.PostAsJsonAsync("api/PasswordManager/add-passwords", new[] { item });
        var responseContents = (await
response.Content.ReadFromJsonAsync<IEnumerable<GeneralResponseWithPayload>>())?.ToList()
                               ?? new List<GeneralResponseWithPayload>();

        var bad = responseContents.Where(r => !r.Flag).ToList();
        if (bad.Count > 0 || responseContents.Count == 0)
        {
            foreach (var br in bad)
            {
                await jsRuntime.InvokeVoidAsync("NOTIFY.toast", "error", br.Message, "Error");
            }
            if (responseContents.Count == 0)
            {
                await jsRuntime.InvokeVoidAsync("NOTIFY.toast", "error", "No response from server.", "Error");
            }
            return false;
        }

        var created = responseContents[0];
        item.Id = int.Parse(created.Payload);
        await jsRuntime.InvokeVoidAsync("NOTIFY.toast", "success", created.Message, "Success");
        Items.Add(item);
        return true;
    }

    private async Task<bool> UpdateAsync(PasswordAccountDTO item)
    {
        var previousUpdatedAt = item.LastUpdatedAt;
        item.LastUpdatedAt = DateTime.UtcNow;

        var response = await httpClient.PutAsJsonAsync("api/PasswordManager/update-password", item);
        var responseContent = await response.Content.ReadFromJsonAsync<HandyGeneralResponse>();

        if (responseContent is null || !responseContent.Flag)
        {
            item.LastUpdatedAt = previousUpdatedAt;
            await jsRuntime.InvokeVoidAsync("NOTIFY.toast", "error", responseContent?.Message ?? "Update failed.", "Error");
            return false;
        }

        await jsRuntime.InvokeVoidAsync("NOTIFY.toast", "success", responseContent?.Message ?? "Update Success.", "Success");

        return true;
    }

    // ---------- Delete ----------

    private async Task DeleteRow(PasswordAccountDTO item)
    {
        bool confirm = await jsRuntime.InvokeAsync<bool>("NOTIFY.confirm", "Warning", "Are you sure you want to delete this record? THIS ACTION IS IRREVERSIBLE!");

        if (!confirm) return;

        var response = await httpClient.DeleteAsync($"api/PasswordManager/deletePassword/{item.Id}");
        var responseContent = await response.Content.ReadFromJsonAsync<HandyGeneralResponse>();

        if (responseContent is null || !responseContent.Flag)
        {
            await jsRuntime.InvokeVoidAsync("NOTIFY.toast", "error", responseContent?.Message ?? "Delete failed.", "Error");
            return;
        }

        await jsRuntime.InvokeVoidAsync("NOTIFY.toast", "success", responseContent?.Message ?? "Delete Success.", "Success");
        Items.Remove(item);
        await grid.Reload();
    }

    // ---------- CSV upload ----------

    private async Task OnCsvSelected(InputFileChangeEventArgs e)
    {
        pendingUpload.Clear();
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024));
            var text = await reader.ReadToEndAsync();
            pendingUpload = ParseCsv(text);

            if (pendingUpload.Count == 0)
            {
                await jsRuntime.InvokeVoidAsync("NOTIFY.toast", "error", "No rows found in the CSV.", "Error");
            }
        }
        catch (Exception ex)
        {
            await jsRuntime.InvokeVoidAsync("NOTIFY.toast", "error", $"Could not read CSV: {ex.Message}", "Error");
        }
    }

    private async Task SubmitCsvAsync()
    {
        uploading = true;
        try
        {
            var response = await httpClient.PostAsJsonAsync("/api/PasswordManager/upload-csv", pendingUpload);
            var responseContent = await response.Content.ReadFromJsonAsync<HandyGeneralResponse>();

            if (responseContent is null || !responseContent.Flag)
            {
                await jsRuntime.InvokeVoidAsync("NOTIFY.toast", "error", responseContent?.Message ?? "CSV Upload failed.", "Error");
                return;
            }

            await jsRuntime.InvokeVoidAsync("NOTIFY.toast", "success", responseContent?.Message ?? "CSV Upload Success.",
"Success");
            pendingUpload.Clear();

            // Pull fresh data so the grid shows server-assigned Ids
            await LoadAsync();
            await grid.Reload();
        }
        finally
        {
            uploading = false;
        }
    }

    /// <summary>
    /// Maps CSV columns to the DTO by header name (case-insensitive): Title, Username, Password.
    /// Handles quoted fields, so passwords containing commas or quotes work.
    /// </summary>
    private List<PasswordAccountDTO> ParseCsv(string text)
    {
        var rows = SplitCsv(text);
        if (rows.Count < 2) return new();

        var header = rows[0].Select(h => h.Trim()).ToList();
        int Col(string name) => header.FindIndex(h => h.Equals(name, StringComparison.OrdinalIgnoreCase));
        int titleIdx = Col(nameof(PasswordAccountDTO.Title));
        int userIdx = Col(nameof(PasswordAccountDTO.Username));
        int passIdx = Col(nameof(PasswordAccountDTO.Password));

        string Get(List<string> r, int i) => i >= 0 && i < r.Count ? r[i] : "";

        return rows.Skip(1)
            .Where(r => r.Any(f => !string.IsNullOrWhiteSpace(f)))
            .Select(r => new PasswordAccountDTO
            {
                Title = Get(r, titleIdx),
                Username = Get(r, userIdx),
                Password = Get(r, passIdx),
                UserId = userId,
                CreatedAt = DateTime.UtcNow,
                LastUpdatedAt = DateTime.UtcNow,
            })
            .ToList();
    }

    private static List<List<string>> SplitCsv(string text)
    {
        var rows = new List<List<string>>();
        var row = new List<string>();
        var field = new System.Text.StringBuilder();
        bool inQuotes = false;

        for (int i = 0; i < text.Length; i++)
        {
            char c = text[i];
            if (inQuotes)
            {
                if (c == '"' && i + 1 < text.Length && text[i + 1] == '"') { field.Append('"'); i++; }
                else if (c == '"') inQuotes = false;
                else field.Append(c);
            }
            else if (c == '"') inQuotes = true;
            else if (c == ',') { row.Add(field.ToString()); field.Clear(); }
            else if (c == '\n' || c == '\r')
            {
                if (c == '\r' && i + 1 < text.Length && text[i + 1] == '\n') i++;
                row.Add(field.ToString()); field.Clear();
                rows.Add(row); row = new List<string>();
            }
            else field.Append(c);
        }

        if (field.Length > 0 || row.Count > 0)
        {
            row.Add(field.ToString());
            rows.Add(row);
        }
        return rows;
    }

    // ---------- Helpers ----------

    private static PasswordAccountDTO Clone(PasswordAccountDTO p) => new()
    {
        Id = p.Id,
        UserId = p.UserId,
        Title = p.Title,
        Username = p.Username,
        Password = p.Password,
        CreatedAt = p.CreatedAt,
        LastUpdatedAt = p.LastUpdatedAt,
    };

    private static void Restore(PasswordAccountDTO target, PasswordAccountDTO source)
    {
        target.Title = source.Title;
        target.Username = source.Username;
        target.Password = source.Password;
        target.LastUpdatedAt = source.LastUpdatedAt;
    }
}
